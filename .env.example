# ============================================
# 仅供 docker-compose 使用的环境变量
# 复制为 .env 后 docker-compose up 即可
#
# ⚠️ 注意：应用的运行时配置请修改 config/config.yaml
#          此 .env 仅控制 compose 的端口映射等编排参数
# ============================================

# 已有 ES 时：填实际地址，compose 不会启动新 ES
ES_HOST=http://localhost:9200

# 主机端口映射（避免冲突时可修改）
BACKEND_PORT=8080
FRONTEND_PORT=5000
ES_PORT=9200

# 无 ES 时 docker-compose --profile full up 才会启动 ES
APP_MODE=release
LOG_LEVEL=info
